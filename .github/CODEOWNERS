/gradle/libs.versions.toml  @mraaisa-afk
/gradle.properties          @mraaisa-afk
/gradle/wrapper/**          @mraaisa-afk
/DEPENDENCY_MANIFEST.md     @mraaisa-afk

# CI + repo meta - agent must never modify workflows
/.github/workflows/**       @mraaisa-afk
